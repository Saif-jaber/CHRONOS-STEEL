# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# Both the Next app and `prisma.config.ts` read these.

# PostgreSQL connection string. Also used by `npm run db:*`.
DATABASE_URL="postgresql://user:password@localhost:5432/chronos_steel?schema=public"

# Cloudflare R2 (S3-compatible) bucket for seller listing photographs.
# Optional: the storefront runs without these, but sellers cannot upload
# images until all five are set. The bucket needs a CORS policy that allows
# PUT from the app origin, and public read for the uploaded objects.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Stripe (test mode). Checkout is the hosted Stripe page, created server-side,
# so the app only reads the secret key and the webhook signing secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
